# Rapport server local development defaults
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-development-secret
MONGODB_URI=mongodb://127.0.0.1:27017/rapport
# Keep this true for normal local development so startup fails fast when MongoDB is unavailable.
# Set it to false only when intentionally working on server bootstrap without a running MongoDB instance.
DB_REQUIRED=true

