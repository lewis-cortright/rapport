# Rapport server — production environment template
# Copy this file to .env on the production droplet and replace all placeholder values.
# Never commit the final .env to version control.

NODE_ENV=production
PORT=4000

# MongoDB connection string.  Use a URI with a non-root user that has read/write
# access only to the rapport database.
MONGODB_URI=mongodb://rapport_user:STRONG_PASSWORD@127.0.0.1:27017/rapport?authSource=rapport

# Must be true in production so the server refuses to start without a database.
DB_REQUIRED=true

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Keep this value secret and rotate it if ever compromised.
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# The public URL of the frontend — used for CORS allow-list.
# When Nginx proxies /api to the backend on the same host, this is just the
# public domain without a port.
CORS_ORIGIN=https://your-domain.example.com

